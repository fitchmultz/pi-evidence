{
  "name": "pi-evidence",
  "version": "0.1.0",
  "private": true,
  "description": "Local exact-head gate evidence for Git commits",
  "type": "module",
  "bin": {
    "evidence": "dist/evidence.js"
  },
  "files": [
    "dist/",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-evidence.git"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
